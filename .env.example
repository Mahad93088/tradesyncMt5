# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Supabase Cloud Database & Authentication (Client-side publishable key)
# DO NOT commit real keys to GitHub.
# For Vercel deployments, configure these in:
# Vercel Project Settings > Environment Variables
# https://vercel.com/docs/projects/environment-variables
# ==============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-Side Only: Supabase Service Role Key (NEVER exposed to frontend bundle or browser)
# Used exclusively in secure server-side functions (e.g., promote-user).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Application Port
PORT=3000

