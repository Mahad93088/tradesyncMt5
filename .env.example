# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Cloud Database & Authentication (Client-side anon keys)
# Configure these in AI Studio or your deployment environment to enable live cloud persistence.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-Side Only: Supabase Service Role Key (NEVER exposed to frontend bundle or browser)
# Used exclusively in server.ts for authorized administrative operations (e.g., promote-user).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Application Port
PORT=3000
